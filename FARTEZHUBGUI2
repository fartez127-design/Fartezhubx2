local function RefreshConfigList()
	for _, c in ipairs(dropdownListFrame:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	if not HasFileSystem() then return end

	local files = listfiles(ConfigFolder)
	local count = 0
	for _, filepath in ipairs(files) do
		local filename = filepath:match("([^/\\]+)%.json$")
		if filename and filename ~= "_autoload" then
			count = count + 1
			local itemBtn = Instance.new("TextButton")
			itemBtn.Size = UDim2.new(1, 0, 0, 26)
			itemBtn.BackgroundColor3 = Theme.ElementBg
			itemBtn.BackgroundTransparency = 0.5
			itemBtn.Text = "  " .. filename
			itemBtn.TextColor3 = Theme.Text
			itemBtn.Font = Enum.Font.Gotham
			itemBtn.TextSize = 12
			itemBtn.TextXAlignment = Enum.TextXAlignment.Left
			itemBtn.Parent = dropdownListFrame

			itemBtn.MouseButton1Click:Connect(function()
				selectedConfig = filename
				dropdownText.Text = filename
				dropdownOpen = false
				dropdownListFrame.Visible = false
			end)
		end
	end

	if count == 0 then
		local emptyBtn = Instance.new("TextButton")
		emptyBtn.Size = UDim2.new(1, 0, 0, 26)
		emptyBtn.BackgroundTransparency = 1
		emptyBtn.Text = "  No saved configs"
		emptyBtn.TextColor3 = Theme.SubText
		emptyBtn.Font = Enum.Font.Gotham
		emptyBtn.TextSize = 12
		emptyBtn.TextXAlignment = Enum.TextXAlignment.Left
		emptyBtn.Parent = dropdownListFrame
	end
end

