CreateButtonPair(
    "Create", Theme.Text, function()
        local typedName = configNameInput.Text:gsub("[^%w_%-]", "")
        if typedName ~= "" then
            SaveConfigFile(typedName)
            configNameInput.Text = ""
        end
    end,
    "Save", Theme.Text, function()
        local targetName = GetTargetConfigName()
        if targetName then
            SaveConfigFile(targetName)
            configNameInput.Text = ""
        end
    end
)

CreateButtonPair(
    "Load", Theme.Text, function()
        if selectedConfig ~= "--" then
            LoadConfigFile(selectedConfig)
        end
    end,
    "Delete", Theme.Red, function()
        if HasFileSystem() and selectedConfig ~= "--" then
            local path = ConfigFolder .. "/" .. selectedConfig .. ".json"
            if isfile(path) then delfile(path) end
            if HubState.CurrentConfig == selectedConfig then HubState.CurrentConfig = "none" end
            if HubState.AutoloadConfig == selectedConfig then
                if isfile(AutoloadFile) then delfile(AutoloadFile) end
                HubState.AutoloadConfig = "none"
            end
            selectedConfig = "--"
            dropdownText.Text = "--"
            UpdateConfigStatusLabel()
            RefreshConfigList()
        end
    end
)

CreateButtonPair(
    "Set autoload", Theme.Text, function()
        if HasFileSystem() and selectedConfig ~= "--" then
            writefile(AutoloadFile, selectedConfig)
            HubState.AutoloadConfig = selectedConfig
            UpdateConfigStatusLabel()
        end
    end,
    "Clear autoload", Theme.Text, function()
        if HasFileSystem() and isfile(AutoloadFile) then
            delfile(AutoloadFile)
        end
        HubState.AutoloadConfig = "none"
        UpdateConfigStatusLabel()
    end
)

AddLabel(ConfigsCard, "Autoload mode", Theme.Text)
local autoloadModeBtn = AddButton(ConfigsCard, "Mode: Always (Auto Load on Execute)", Theme.Green, function() end)
autoloadModeBtn.MouseButton1Click:Connect(function()
    if HubState.AutoloadMode == "Always" then
        HubState.AutoloadMode = "Disabled"
        autoloadModeBtn.Text = "Mode: Disabled"
        autoloadModeBtn.TextColor3 = Theme.SubText
    else
        HubState.AutoloadMode = "Always"
        autoloadModeBtn.Text = "Mode: Always (Auto Load on Execute)"
        autoloadModeBtn.TextColor3 = Theme.Green
    end
end)

RefreshConfigList()
if HasFileSystem() and isfile(AutoloadFile) then
    local autoName = readfile(AutoloadFile)
    if autoName and autoName ~= "" and isfile(ConfigFolder .. "/" .. autoName .. ".json") then
        HubState.AutoloadConfig = autoName
        UpdateConfigStatusLabel()
        LoadConfigFile(autoName)
    end
end

