local ManagedFeatureLabels = {}
local ManagedStrokes = {}

local targetUIScale = HubSettings.DefaultScale
local targetFeatureTextSize = HubSettings.DefaultTextSize
local currentFeatureTextSize = HubSettings.DefaultTextSize

local function RegisterFeatureText(labelObj)
	table.insert(ManagedFeatureLabels, labelObj)
end

local function RegisterBorderStroke(strokeObj)
	table.insert(ManagedStrokes, strokeObj)
end

local function SetTargetFeatureTextSize(sizeVal)
	targetFeatureTextSize = math.clamp(math.floor((tonumber(sizeVal) or HubSettings.DefaultTextSize) + 0.5), 1, 100)
end

local function ApplyTextColorPreset(presetName)
	local preset = TextColorPresets[presetName] or TextColorPresets["White"]
	for _, lbl in ipairs(ManagedFeatureLabels) do
		if lbl and lbl.Parent then
			lbl.TextColor3 = preset.Color
			local existingStroke = lbl:FindFirstChild("FeatureTextOutline")
			if preset.Stroke then
				if not existingStroke then
					existingStroke = Instance.new("UIStroke")
					existingStroke.Name = "FeatureTextOutline"
					existingStroke.Color = Color3.fromRGB(0, 0, 0)
					existingStroke.Thickness = 1.2
					existingStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
					existingStroke.Parent = lbl
				else
					existingStroke.Enabled = true
				end
			elseif existingStroke then
				existingStroke.Enabled = false
			end
		end
	end
end

local function ApplyBorderColorPreset(presetName)
	local targetColor = BorderColorPresets[presetName] or Theme.Border
	Theme.Border = targetColor
	for _, stroke in ipairs(ManagedStrokes) do
		if stroke and stroke.Parent then
			stroke.Color = targetColor
		end
	end
end

