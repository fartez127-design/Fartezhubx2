local function SaveConfigFile(cfgName)
    if not HasFileSystem() or not cfgName or cfgName == "" or cfgName == "--" then return end
    local data = {
        Toggles = HubState.Toggles,
        Sliders = HubState.Sliders
    }
    writefile(ConfigFolder .. "/" .. cfgName .. ".json", HttpService:JSONEncode(data))
    selectedConfig = cfgName
    dropdownText.Text = cfgName
    HubState.CurrentConfig = cfgName
    UpdateConfigStatusLabel()
    RefreshConfigList()
end

local function LoadConfigFile(cfgName)
    if not HasFileSystem() or not cfgName or cfgName == "" or cfgName == "--" then return end
    local path = ConfigFolder .. "/" .. cfgName .. ".json"
    if isfile(path) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if ok and data then
            if data.Toggles then
                for k, v in pairs(data.Toggles) do
                    if HubState.ToggleSetters[k] then HubState.ToggleSetters[k](v) end
                end
            end
            if data.Sliders then
                for k, v in pairs(data.Sliders) do
                    if HubState.SliderSetters[k] then HubState.SliderSetters[k](v) end
                end
            end
            HubState.CurrentConfig = cfgName
            selectedConfig = cfgName
            dropdownText.Text = cfgName
            UpdateConfigStatusLabel()
        end
    end
end

