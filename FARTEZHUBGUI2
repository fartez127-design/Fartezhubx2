-- Extreme FPS Boost (Lowest Graphics + Strip Details)
-- ============================================
local fpsDescendantConn
local function StripUnnecessaryDetails(obj)
    pcall(function()
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
            if obj:IsA("MeshPart") then
                obj.RenderFidelity = Enum.RenderFidelity.Performance
                obj.TextureID = ""
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("SurfaceAppearance") or obj:IsA("ShirtGraphic") or obj:IsA("CharacterMesh") then
            obj:Destroy()
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            obj.Enabled = false
        elseif obj:IsA("Explosion") then
            obj.Visible = false
        elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            obj.Enabled = false
        elseif obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Sky") or obj:IsA("Clouds") then
            if obj:IsA("PostEffect") then
                obj.Enabled = false
            else
                obj:Destroy()
            end
        end
    end)
end

local function EnableUltraFPSBoost()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 9e9
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        sethiddenproperty(Lighting, "Technology", Enum.Technology.Voxel)
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01

        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
            terrain.Decoration = false
        end

        for _, v in ipairs(Lighting:GetChildren()) do
            StripUnnecessaryDetails(v)
        end
        for _, v in ipairs(workspace:GetDescendants()) do
            StripUnnecessaryDetails(v)
        end

        if not fpsDescendantConn then
            fpsDescendantConn = workspace.DescendantAdded:Connect(function(desc)
                if HubState.Toggles["UltraFPS"] then
                    StripUnnecessaryDetails(desc)
                end
            end)
        end
    end)
end

