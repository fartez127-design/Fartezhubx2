	if type(GameAPI.GetAllBackpackPets) ~= "function" then return end
	local pets = GameAPI.GetAllBackpackPets()
	local rarities = GameState.SellFilterRarities or {}
	local toSell = {}
	for _, pet in ipairs(pets) do
		if not pet.IsLocked and rarities[pet.Rarity] == true then
			table.insert(toSell, pet.Uid)
		end
	end
	if #toSell > 0 then
		local remotes = GameAPI.Remotes or (RS:FindFirstChild("Remotes"))
		if remotes and remotes:FindFirstChild("PetAction") then
			pcall(function()
				remotes.PetAction:InvokeServer("Sell", toSell)
			end)
		end
	end
	sellInfoLbl.Text = "Total Pets: " .. tostring(#pets) .. " | Sold: " .. tostring(#toSell)
end

