RunService.RenderStepped:Connect(function(dt)
	local alpha = math.clamp(dt * 18, 0, 1)

	if math.abs(UIScale.Scale - targetUIScale) > 0.0005 then
		UIScale.Scale = UIScale.Scale + (targetUIScale - UIScale.Scale) * alpha
	else
		UIScale.Scale = targetUIScale
	end

	if math.abs(currentFeatureTextSize - targetFeatureTextSize) > 0.05 then
		currentFeatureTextSize = currentFeatureTextSize + (targetFeatureTextSize - currentFeatureTextSize) * alpha
		local intSize = math.clamp(math.floor(currentFeatureTextSize + 0.5), 1, 100)
		for _, lbl in ipairs(ManagedFeatureLabels) do
			if lbl and lbl.Parent then
				lbl.TextSize = intSize
			end
		end
	elseif currentFeatureTextSize ~= targetFeatureTextSize then
		currentFeatureTextSize = targetFeatureTextSize
		for _, lbl in ipairs(ManagedFeatureLabels) do
			if lbl and lbl.Parent then
				lbl.TextSize = targetFeatureTextSize
			end
		end
	end
end)

