local function AddSmoothSlider(container, flagKey, text, minVal, maxVal, defaultVal, suffix, callback)
    HubState.Sliders[flagKey] = defaultVal

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 0, 46)
    box.BackgroundTransparency = 1
    box.Parent = container

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -68, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Theme.Text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = box

    local valInput = Instance.new("TextBox")
    valInput.Size = UDim2.new(0, 56, 0, 22)
    valInput.Position = UDim2.new(1, -56, 0, 0)
    valInput.BackgroundColor3 = Theme.ElementBg
    valInput.Text = tostring(defaultVal) .. (suffix or "")
    valInput.TextColor3 = Theme.Green
    valInput.Font = Enum.Font.GothamBold
    valInput.TextSize = 12
    valInput.ClearTextOnFocus = false
    valInput.Parent = box
    Instance.new("UICorner", valInput).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", valInput).Color = Theme.Border

    local hitArea = Instance.new("TextButton")
    hitArea.Size = UDim2.new(1, 0, 0, 20)
    hitArea.Position = UDim2.new(0, 0, 0, 24)
    hitArea.BackgroundTransparency = 1
    hitArea.Text = ""
    hitArea.AutoButtonColor = false
    hitArea.Parent = box

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0.5, -3)
    track.BackgroundColor3 = Theme.ElementBg
    track.BorderSizePixel = 0
    track.Parent = hitArea
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local initPct = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initPct, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Green
    fill.BorderSizePixel = 0
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(initPct, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local sliding = false

    local function SetValue(newVal, smooth)
        newVal = math.clamp(math.floor(newVal + 0.5), minVal, maxVal)
        HubState.Sliders[flagKey] = newVal
        local pct = (newVal - minVal) / (maxVal - minVal)
        valInput.Text = tostring(newVal) .. (suffix or "")

        local tInfo = smooth and TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) or TweenInfo.new(0.06, Enum.EasingStyle.Linear)
        TweenService:Create(fill, tInfo, {Size = UDim2.new(pct, 0, 1, 0)}):Play()
        TweenService:Create(knob, tInfo, {Position = UDim2.new(pct, 0, 0.5, 0)}):Play()

        if callback then callback(newVal) end
    end

    HubState.SliderSetters[flagKey] = function(val) SetValue(val, true) end

    local function UpdateFromInput(x)
        if track.AbsoluteSize.X <= 0 then return end
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        SetValue(minVal + (maxVal - minVal) * rel, false)
    end

    hitArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            TweenService:Create(knob, TweenInfo.new(0.12), {Size = UDim2.new(0, 17, 0, 17)}):Play()
            UpdateFromInput(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            sliding = false
            TweenService:Create(knob, TweenInfo.new(0.12), {Size = UDim2.new(0, 14, 0, 14)}):Play()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateFromInput(input.Position.X)
        end
    end)

    valInput.FocusLost:Connect(function()
        local num = tonumber(valInput.Text:match("%d+"))
        if num then
            SetValue(num, true)
        else
            valInput.Text = tostring(HubState.Sliders[flagKey]) .. (suffix or "")
        end
    end)
end

