local function GetRarityByAnimalName(animalName)
    if type(animalName) ~= "string" then return nil end
    local searchName = string.lower(animalName:match("^%s*(.-)%s*$"))

    for _, zoneMap in pairs(ZoneRarityData) do
        for name, rarity in pairs(zoneMap) do
            local normalizedName = string.lower(name:match("^%s*(.-)%s*$"))
            if normalizedName == searchName then
                return rarity
            end
        end
    end
    return nil
end

local function FindTargetAnimalByRarity()
    local pickups = GetAnimalPickups()
    if not pickups then return nil end

    local anySelected = false
    for _, s in pairs(SelectedRarities) do
        if s then anySelected = true; break end
    end
    if not anySelected then return nil end

    for _, obj in ipairs(pickups:GetChildren()) do
        local animalRarity = GetRarityByAnimalName(obj.Name)
        
        if not animalRarity then
            local nameVal = obj:FindFirstChild("AnimalName", true)
            if nameVal and nameVal:IsA("StringValue") then
                animalRarity = GetRarityByAnimalName(nameVal.Value)
            end
        end

        if animalRarity and SelectedRarities[animalRarity] then
            return obj
        end
    end
    return nil
end

local function TriggerStealAction(targetAnimal)
    pcall(function()
        if not targetAnimal then return end

        local char, humanoid, rootPart = GetCharacter()
        local animalPos = GetObjectPosition(targetAnimal)
        
        if rootPart and animalPos and (rootPart.Position - animalPos).Magnitude > 4 then
            rootPart.CFrame = CFrame.new(animalPos + Vector3.new(0, 2, 0))
        end

        for _, desc in ipairs(targetAnimal:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                desc.MaxActivationDistance = 999
                desc.HoldDuration = 0
                desc.RequiresLineOfSight = false
                fireproximityprompt(desc)
            end
        end
        
        for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
            if remote:IsA("RemoteEvent") then
                local rName = remote.Name:lower()
                if rName:find("steal") or rName:find("pickup") or rName:find("animal") then
                    pcall(function()
                        remote:FireServer(targetAnimal)
                    end)
                end
            end
        end
    end)
end

local isStealingInProgress = false
local autoStealRunning = false

-- ================= [ HIGH-PERFORMANCE ANIMALPICKUPS AUTO STEAL ] ================= --
CreateToggle(ZoneTab, "Auto Steal Active", function(state)
    autoStealRunning = state
    if not state then
        isStealingInProgress = false
        local _, humanoid, rootPart = GetCharacter()
        if rootPart then rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        return
    end

    task.spawn(function()
        while autoStealRunning do
            local char, humanoid, rootPart = GetCharacter()
            if not char or not rootPart then
                task.wait(0.2)
                continue
            end

            local targetAnimal = FindTargetAnimalByRarity()
            local pickups = GetAnimalPickups()
            
            if targetAnimal and pickups then
                isStealingInProgress = true
                
                local targetPos = GetObjectPosition(targetAnimal)
                if targetPos then
                    local timeout = 0
                    local reached = false
                    
                    while autoStealRunning and targetAnimal.Parent == pickups do
                        local currPos = GetObjectPosition(targetAnimal)
                        if not currPos then break end
                        
                        reached = PerformDash(rootPart, currPos)
                        if reached then break end
                        
                        task.wait(0.02)
                        timeout += 0.02
                        if timeout > 8 then break end
                    end
                    
                    if reached and targetAnimal.Parent == pickups then
                        local stealTimer = 0
                        while autoStealRunning and targetAnimal.Parent == pickups and stealTimer < 3 do
                            TriggerStealAction(targetAnimal)
                            task.wait(0.04)
                            stealTimer += 0.04
                        end
                    end
                    
                    if targetAnimal.Parent ~= pickups then
                        local safePos = GetSafeZonePosition()
                        if safePos then
                            local returnTimeout = 0
                            
                            pcall(function()
                                for _, part in ipairs(char:GetChildren()) do
                                    if part:IsA("BasePart") then part.CanCollide = false end
                                end
                                if humanoid then
                                    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                                end
                            end)

                            while autoStealRunning do
                                if targetAnimal.Parent == pickups then
                                    break
                                end

                                local currentPos = rootPart.Position
                                local flatCurrent = Vector3.new(currentPos.X, 0, currentPos.Z)
                                local flatTarget = Vector3.new(safePos.X, 0, safePos.Z)
                                local dist = (flatCurrent - flatTarget).Magnitude

                                if dist <= 5 then break end

                                local dir = (flatTarget - flatCurrent).Unit
                                local dashSpeed = 40 + ((globalDashSpeed - 1) / 999) * (1200 - 40)
                                
                                rootPart.CFrame = CFrame.lookAt(currentPos, currentPos + dir)
                                rootPart.AssemblyLinearVelocity = Vector3.new(dir.X * dashSpeed, 0, dir.Z * dashSpeed)

                                task.wait(0.02)
                                returnTimeout += 0.02
                                if returnTimeout > 6 then break end
                            end

                            pcall(function()
                                for _, part in ipairs(char:GetChildren()) do
                                    if part:IsA("BasePart") then part.CanCollide = true end
                                end
                                if humanoid then
                                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                                end
                            end)
                        end
                    end
                end
                
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                isStealingInProgress = false
            end
            
            task.wait(0.1)
        end
        
        isStealingInProgress = false
        local _, humanoid, rootPart = GetCharacter()
        if rootPart then rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
end)

