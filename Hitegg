local function GetZoneList()
    local zones = {}
    local animals = ReplicatedStorage:FindFirstChild("Animals")
    local normal = animals and animals:FindFirstChild("Normal")
    if not normal then return zones end
    for i = 1, 9 do
        local zone = normal:FindFirstChild("Zone_" .. i)
        if zone then
            table.insert(zones, "Zone " .. i)
        end
    end
    return zones
end

local function GetCharacter()
    local char = player.Character
    if not char then return nil, nil, nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return nil, nil, nil end
    return char, humanoid, rootPart
end

local function GetObjectPosition(object)
    if not object then return nil end
    if object:IsA("BasePart") then return object.Position end
    if object:IsA("Model") then
        if object.PrimaryPart then return object.PrimaryPart.Position end
        local hrp = object:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") then return hrp.Position end
        local part = object:FindFirstChildWhichIsA("BasePart")
        if part then return part.Position end
    end
    return nil
end

local function PerformDash(rootPart, targetPos)
    local horizontalTarget = Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z)
    local distance = (Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z) - Vector3.new(horizontalTarget.X, 0, horizontalTarget.Z)).Magnitude
    
    if distance > 4 then
        local offset = Vector3.new(
            horizontalTarget.X - rootPart.Position.X,
            0,
            horizontalTarget.Z - rootPart.Position.Z
        )
        
        if offset.Magnitude > 0.01 then
            local direction = offset.Unit
            local dashSpeed = 40 + ((globalDashSpeed - 1) / 999) * (1200 - 40)
            
            rootPart.CFrame = CFrame.lookAt(
                rootPart.Position,
                rootPart.Position + direction
            )
            
            rootPart.AssemblyLinearVelocity = Vector3.new(
                direction.X * dashSpeed,
                0, 
                direction.Z * dashSpeed
            )
        end
        return false
    else
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        return true
    end
end

